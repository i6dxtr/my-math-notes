    {
        "trigger": "(arcsin|sin|arccos|cos|arctan|tan|csc|sec|cot)([a-zA-Z]);",
        "replacement": "\\[[0]]($1)\\ $2",
        "options": "rmA",
        "description": "Add backslash before trig functions and surround following variable with parentheses"
    },
    {
        "trigger": "(sinh|cosh|tanh|coth)([A-Za-z]);",
        "replacement": "\\[[0]] ([[1]]) ",
